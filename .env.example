# Set to false to reopen the live site (production is closed by default on Vercel)
SITE_CLOSED=

# ─── Turso (orders + live rate) ─────────────────────────────────────────────
# Leave empty locally to use file:local-dev.db for testing (never on Vercel)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Optional override for the local test database
LOCAL_SQLITE_URL=

# Dev fallback: RMB per 1 GHS if Turso is unavailable or has no rate yet
DEFAULT_EXCHANGE_RATE=
DEFAULT_SMALL_EXCHANGE_RATE=

# Protect /admin/orders and GET/PATCH /api/admin/orders (x-admin-key header)
ADMIN_ORDERS_KEY=

# ─── Rate portal (5 taps on live rate on home — admins only) ─────────────────
RATE_PORTAL_USERNAME=
RATE_PORTAL_PASSWORD=
RATE_ADMIN_SESSION_SECRET=

# ─── Airtable (user sign-up / login only) ───────────────────────────────────
AIRTABLE_BASE_ID=
AIRTABLE_PERSONAL_ACCESS_TOKEN=

# ─── NextAuth (sign-in / dashboard sessions) ────────────────────────────────
NEXTAUTH_URL=http://localhost:3002
NEXTAUTH_SECRET=

# Gmail app password (16 chars, spaces optional): password reset + new-order alerts
EMAIL_USER=
EMAIL_PASSWORD=
# Where to send "new purchase submitted" emails (your ops inbox)
ADMIN_NOTIFY_EMAIL=

# ─── Moolre (MoMo collection — never commit real keys) ──────────────────────
MOOLRE_API_USER=
MOOLRE_API_PUBKEY=
MOOLRE_ACCOUNT_NUMBER=
MOOLRE_API_KEY=
# Callback URL in Moolre: https://tradermb.com/api/moolre/webhook
MOOLRE_WEBHOOK_SECRET=
# Optional; defaults to https://api.moolre.com
MOOLRE_API_BASE=
